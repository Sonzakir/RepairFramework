# Copy this file to .env and fill in your real key(s).
# .env is gitignored — your real key is never committed.
#
# You can also generate .env interactively (masked input, no shell history):
#   python -m apr_framework configure
#
# Required for: python -m apr_framework repair --technique llm ...
# Get a key from: https://gpt.ruhr-uni-bochum.de/app/documentation
GPT_AT_RUB_API_KEY=your-api-key-here

# Only needed if you point --llm-base-url at a different provider and pass
# --llm-api-key-env OPENAI_API_KEY (or another custom variable name).
# OPENAI_API_KEY=your-api-key-here
